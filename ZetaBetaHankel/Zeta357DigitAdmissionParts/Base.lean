/-- A deliberately coarse exact majorant is enough for the seed packet.
No floating-point logarithm enters this proof. -/
theorem seed_upper_of_mul_check {u : ℝ}
    (hu : 0 ≤ u) (hcheck : u * (3 : ℝ) ^ 1424 ≤ 1) :
    u ≤ Real.exp (-1424 : ℝ) := by
  have he : Real.exp (1424 : ℝ) ≤ (3 : ℝ) ^ 1424 := by
    calc
      Real.exp (1424 : ℝ) = Real.exp (1 : ℝ) ^ 1424 := by
        simpa using (Real.exp_nat_mul (1 : ℝ) 1424)
      _ ≤ (3 : ℝ) ^ 1424 :=
        pow_le_pow_left₀ (le_of_lt (Real.exp_pos 1))
          Real.exp_one_lt_three.le 1424
  have hm : u * Real.exp (1424 : ℝ) ≤ 1 :=
    (mul_le_mul_of_nonneg_left he hu).trans hcheck
  have hd : u ≤ 1 / Real.exp (1424 : ℝ) :=
    (le_div_iff₀ (Real.exp_pos (1424 : ℝ))).2 hm
  simpa only [one_div, ← Real.exp_neg] using hd

theorem transfer35_factor :
    (42 : ℝ) ^ 400 =
      Real.exp (alpha35 * (40 : ℝ) ^ 2 +
        C35 * (40 : ℝ) * Real.log (42 : ℝ)) := by
  calc
    (42 : ℝ) ^ 400 = Real.exp ((400 : ℝ) * Real.log (42 : ℝ)) := by
      symm
      simpa only [Nat.cast_ofNat, Real.exp_log (by norm_num : (0 : ℝ) < 42)]
        using (Real.exp_nat_mul (Real.log (42 : ℝ)) 400)
    _ = _ := by congr 1; norm_num [alpha35, C35]

theorem transfer57_factor :
    (42 : ℝ) ^ 440 =
      Real.exp (alpha57 * (40 : ℝ) ^ 2 +
        C57 * (40 : ℝ) * Real.log (42 : ℝ)) := by
  calc
    (42 : ℝ) ^ 440 = Real.exp ((440 : ℝ) * Real.log (42 : ℝ)) := by
      symm
      simpa only [Nat.cast_ofNat, Real.exp_log (by norm_num : (0 : ℝ) < 42)]
        using (Real.exp_nat_mul (Real.log (42 : ℝ)) 440)
    _ = _ := by congr 1; norm_num [alpha57, C57]

/-- Rational enclosure checks imply the exact old admission fields.
The enclosure premises concern the canonical value, so they must be supplied
by a sound interval evaluator together with the canonical-polynomial and
actual-zeta bridges. They are not inferred from digits alone. -/
theorem admission_of_rational_enclosures
    (l3 u3 l5 u5 l7 u7 : ℚ)
    (degree3 : (primitivePolynomial 1 0).natDegree = 37)
    (degree5 : (primitivePolynomial 2 0).natDegree = 37)
    (degree7 : (primitivePolynomial 3 0).natDegree = 37)
    (h3 : (l3 : ℝ) ≤ |value 1 0| ∧ |value 1 0| ≤ (u3 : ℝ))
    (h5 : (l5 : ℝ) ≤ |value 2 0| ∧ |value 2 0| ≤ (u5 : ℝ))
    (h7 : (l7 : ℝ) ≤ |value 3 0| ∧ |value 3 0| ≤ (u7 : ℝ))
    (positive3 : 0 < l3) (positive5 : 0 < l5) (positive7 : 0 < l7)
    (seedCheck : u3 * (3 : ℚ) ^ 1424 ≤ 1)
    (transfer35Check : u5 ≤ (42 : ℚ) ^ 400 * l3)
    (transfer57Check : u7 ≤ (42 : ℚ) ^ 440 * l5) :
    N0Admission := by
  have hp3 : (0 : ℝ) < (l3 : ℝ) := by exact_mod_cast positive3
  have hp5 : (0 : ℝ) < (l5 : ℝ) := by exact_mod_cast positive5
  have hp7 : (0 : ℝ) < (l7 : ℝ) := by exact_mod_cast positive7
  refine {
    degree3 := degree3
    degree5 := degree5
    degree7 := degree7
    seed3_40 := ?_
    transfer35_40 := ?_
    transfer57_40 := ?_
  }
  · refine ⟨hp3.trans_le h3.1, ?_⟩
    have hc : (u3 : ℝ) * (3 : ℝ) ^ 1424 ≤ 1 := by
      exact_mod_cast seedCheck
    have hu : (0 : ℝ) ≤ (u3 : ℝ) := (abs_nonneg _).trans h3.2
    calc
      |value 1 0| ≤ (u3 : ℝ) := h3.2
      _ ≤ Real.exp (-1424 : ℝ) := seed_upper_of_mul_check hu hc
      _ = Real.exp (-epsilon3 * (40 : ℝ) ^ 2) := by
        exact congrArg Real.exp (by norm_num [epsilon3] :
          (-1424 : ℝ) = -epsilon3 * (40 : ℝ) ^ 2)
  · refine ⟨hp5.trans_le h5.1, ?_⟩
    have hc : (u5 : ℝ) ≤ (42 : ℝ) ^ 400 * (l3 : ℝ) := by
      exact_mod_cast transfer35Check
    calc
      |value 2 0| ≤ (u5 : ℝ) := h5.2
      _ ≤ (42 : ℝ) ^ 400 * (l3 : ℝ) := hc
      _ ≤ (42 : ℝ) ^ 400 * |value 1 0| :=
        mul_le_mul_of_nonneg_left h3.1 (by positivity)
      _ = _ := by rw [transfer35_factor]
  · refine ⟨hp7.trans_le h7.1, ?_⟩
    have hc : (u7 : ℝ) ≤ (42 : ℝ) ^ 440 * (l5 : ℝ) := by
      exact_mod_cast transfer57Check
    calc
      |value 3 0| ≤ (u7 : ℝ) := h7.2
      _ ≤ (42 : ℝ) ^ 440 * (l5 : ℝ) := hc
      _ ≤ (42 : ℝ) ^ 440 * |value 2 0| :=
        mul_le_mul_of_nonneg_left h5.1 (by positivity)
      _ = _ := by rw [transfer57_factor]

