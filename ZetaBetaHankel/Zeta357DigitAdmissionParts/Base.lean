/- Exact integer trace checker.  No floating-point arithmetic is trusted. -/
namespace ZetaBetaHankel.Zeta357DigitAdmission

structure Box where
  lo : ℤ
  hi : ℤ
  deriving DecidableEq, Repr

def zeroBox : Box := ⟨0, 0⟩

def headBox (bs : List Box) : Box := bs.headD zeroBox

/-- `D*x` lies between two exact integer endpoints. -/
def Contains (D : ℤ) (b : Box) (x : ℝ) : Prop :=
  (b.lo : ℝ) ≤ (D : ℝ) * x ∧ (D : ℝ) * x ≤ (b.hi : ℝ)

/-- The four-corner inequalities certify one rounded Horner step. -/
def StepOK (D : ℤ) (x old : Box) (c : ℤ) (out : Box) : Prop :=
  (out.lo - c * D) * D ≤ old.lo * x.lo ∧
  (out.lo - c * D) * D ≤ old.lo * x.hi ∧
  (out.lo - c * D) * D ≤ old.hi * x.lo ∧
  (out.lo - c * D) * D ≤ old.hi * x.hi ∧
  old.lo * x.lo ≤ (out.hi - c * D) * D ∧
  old.lo * x.hi ≤ (out.hi - c * D) * D ∧
  old.hi * x.lo ≤ (out.hi - c * D) * D ∧
  old.hi * x.hi ≤ (out.hi - c * D) * D

instance (D : ℤ) (x old : Box) (c : ℤ) (out : Box) :
    Decidable (StepOK D x old c out) := by
  unfold StepOK
  infer_instance

def evalCoeffs : List ℤ → ℝ → ℝ
  | [], _ => 0
  | c :: cs, x => (c : ℝ) + x * evalCoeffs cs x

def polyOfCoeffs : List ℤ → Polynomial ℤ
  | [] => 0
  | c :: cs => Polynomial.C c + Polynomial.X * polyOfCoeffs cs

theorem eval_map_polyOfCoeffs (cs : List ℤ) (x : ℝ) :
    ((polyOfCoeffs cs).map (algebraMap ℤ ℝ)).eval x = evalCoeffs cs x := by
  induction cs with
  | nil => simp [polyOfCoeffs, evalCoeffs]
  | cons c cs ih =>
      simp only [polyOfCoeffs, Polynomial.map_add, Polynomial.map_mul,
        Polynomial.map_C, Polynomial.map_X, Polynomial.eval_add,
        Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X, evalCoeffs]
      rw [ih]
      simp

/-- Trace boxes follow ascending coefficient order.  The last box is the
    evaluation of the leading coefficient; the implicit tail is zero. -/
def checkTrace (D : ℤ) (x : Box) : List ℤ → List Box → Bool
  | [], [] => true
  | c :: cs, out :: outs =>
      checkTrace D x cs outs && decide (StepOK D x (headBox outs) c out)
  | _, _ => false

/-- One-step checker inversion uses only explicit Boolean reflection.
This is separated from the induction so its audit can localize failures. -/
theorem checkTrace_cons_success {D : ℤ} {xb out : Box} {c : ℤ}
    {cs : List ℤ} {outs : List Box}
    (h : checkTrace D xb (c :: cs) (out :: outs) = true) :
    checkTrace D xb cs outs = true ∧ StepOK D xb (headBox outs) c out := by
  change (checkTrace D xb cs outs &&
    decide (StepOK D xb (headBox outs) c out)) = true at h
  have hb : checkTrace D xb cs outs = true ∧
      decide (StepOK D xb (headBox outs) c out) = true :=
    Eq.mp (Bool.and_eq_true (checkTrace D xb cs outs)
      (decide (StepOK D xb (headBox outs) c out))) h
  exact ⟨hb.1, of_decide_eq_true hb.2⟩



private theorem mul_le_of_corners
    {a b c d x y u : ℝ}
    (hax : a ≤ x) (hxb : x ≤ b) (hcy : c ≤ y) (hyd : y ≤ d)
    (hac : a * c ≤ u) (had : a * d ≤ u)
    (hbc : b * c ≤ u) (hbd : b * d ≤ u) : x * y ≤ u := by
  by_cases hy : 0 ≤ y
  · have hxy : x * y ≤ b * y := mul_le_mul_of_nonneg_right hxb hy
    by_cases hb : 0 ≤ b
    · exact hxy.trans ((mul_le_mul_of_nonneg_left hyd hb).trans hbd)
    · exact hxy.trans ((mul_le_mul_of_nonpos_left hcy (le_of_lt (lt_of_not_ge hb))).trans hbc)
  · have hxy : x * y ≤ a * y :=
      mul_le_mul_of_nonpos_right hax (le_of_lt (lt_of_not_ge hy))
    by_cases ha : 0 ≤ a
    · exact hxy.trans ((mul_le_mul_of_nonneg_left hyd ha).trans had)
    · exact hxy.trans ((mul_le_mul_of_nonpos_left hcy (le_of_lt (lt_of_not_ge ha))).trans hac)


private theorem le_mul_of_corners
    {a b c d x y l : ℝ}
    (hax : a ≤ x) (hxb : x ≤ b) (hcy : c ≤ y) (hyd : y ≤ d)
    (hac : l ≤ a * c) (had : l ≤ a * d)
    (hbc : l ≤ b * c) (hbd : l ≤ b * d) : l ≤ x * y := by
  by_cases hy : 0 ≤ y
  · have hxy : a * y ≤ x * y := mul_le_mul_of_nonneg_right hax hy
    by_cases ha : 0 ≤ a
    · exact (hac.trans (mul_le_mul_of_nonneg_left hcy ha)).trans hxy
    · exact (had.trans (mul_le_mul_of_nonpos_left hyd (le_of_lt (lt_of_not_ge ha)))).trans hxy
  · have hxy : b * y ≤ x * y :=
      mul_le_mul_of_nonpos_right hxb (le_of_lt (lt_of_not_ge hy))
    by_cases hb : 0 ≤ b
    · exact (hbc.trans (mul_le_mul_of_nonneg_left hcy hb)).trans hxy
    · exact (hbd.trans (mul_le_mul_of_nonpos_left hyd (le_of_lt (lt_of_not_ge hb)))).trans hxy


theorem step_sound {D : ℤ} {xb old out : Box} {c : ℤ} {x y : ℝ}
    (hD : 0 < D) (hx : Contains D xb x) (hy : Contains D old y)
    (hs : StepOK D xb old c out) : Contains D out ((c : ℝ) + x * y) := by
  have hDr : (0 : ℝ) < (D : ℝ) := by exact_mod_cast hD
  rcases hs with ⟨h1, h2, h3, h4, h5, h6, h7, h8⟩
  have hl : ((out.lo : ℝ) - (c : ℝ) * (D : ℝ)) * (D : ℝ) ≤
      ((D : ℝ) * y) * ((D : ℝ) * x) := by
    apply le_mul_of_corners hy.1 hy.2 hx.1 hx.2
    · exact_mod_cast h1
    · exact_mod_cast h2
    · exact_mod_cast h3
    · exact_mod_cast h4
  have hu : ((D : ℝ) * y) * ((D : ℝ) * x) ≤
      ((out.hi : ℝ) - (c : ℝ) * (D : ℝ)) * (D : ℝ) := by
    apply mul_le_of_corners hy.1 hy.2 hx.1 hx.2
    · exact_mod_cast h5
    · exact_mod_cast h6
    · exact_mod_cast h7
    · exact_mod_cast h8
  constructor
  · apply (mul_le_mul_iff_right₀ hDr).mp
    calc
      (D : ℝ) * (out.lo : ℝ) =
          ((out.lo : ℝ) - (c : ℝ) * (D : ℝ)) * (D : ℝ) +
            (c : ℝ) * (D : ℝ) ^ 2 := by ring
      _ ≤ ((D : ℝ) * y) * ((D : ℝ) * x) + (c : ℝ) * (D : ℝ) ^ 2 :=
        add_le_add hl (le_refl _)
      _ = (D : ℝ) * ((D : ℝ) * ((c : ℝ) + x * y)) := by ring
  · apply (mul_le_mul_iff_right₀ hDr).mp
    calc
      (D : ℝ) * ((D : ℝ) * ((c : ℝ) + x * y)) =
          ((D : ℝ) * y) * ((D : ℝ) * x) + (c : ℝ) * (D : ℝ) ^ 2 := by ring
      _ ≤ ((out.hi : ℝ) - (c : ℝ) * (D : ℝ)) * (D : ℝ) +
          (c : ℝ) * (D : ℝ) ^ 2 := add_le_add hu (le_refl _)
      _ = (D : ℝ) * (out.hi : ℝ) := by ring


theorem checkTrace_sound {D : ℤ} {xb : Box} {x : ℝ}
    (hD : 0 < D) (hx : Contains D xb x)
    (cs : List ℤ) (trace : List Box)
    (h : checkTrace D xb cs trace = true) :
    Contains D (headBox trace) (evalCoeffs cs x) := by
  induction cs generalizing trace with
  | nil =>
      cases trace with
      | nil =>
          simp [Contains, headBox, zeroBox, evalCoeffs]
      | cons b bs =>
          change (false : Bool) = true at h
          cases h
  | cons c cs ih =>
      cases trace with
      | nil =>
          change (false : Bool) = true at h
          cases h
      | cons out outs =>
          have hs : checkTrace D xb cs outs = true ∧
              StepOK D xb (headBox outs) c out :=
            checkTrace_cons_success h
          have htail : Contains D (headBox outs) (evalCoeffs cs x) :=
            ih outs hs.1
          change Contains D out ((c : ℝ) + x * evalCoeffs cs x)
          exact step_sound (D := D) (xb := xb) (old := headBox outs)
            (out := out) (c := c) (x := x) (y := evalCoeffs cs x)
            hD hx htail hs.2


end ZetaBetaHankel.Zeta357DigitAdmission

