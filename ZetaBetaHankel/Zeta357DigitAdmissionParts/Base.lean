theorem transfer35_checked : valueBox5.hi ≤ (42 : ℤ) ^ 400 * valueBox3.lo := by decide

theorem transfer57_checked : valueBox7.hi ≤ (42 : ℤ) ^ 440 * valueBox5.lo := by decide

/-- The conjunction contains actual finite checks, with no semantic premise. -/
theorem coordinates_checked :
    checkTrace denominator zetaBox3 coeff3 trace3 = true ∧
    checkTrace denominator zetaBox5 coeff5 trace5 = true ∧
    checkTrace denominator zetaBox7 coeff7 trace7 = true ∧
    0 < valueBox3.lo ∧ 0 < valueBox5.lo ∧ 0 < valueBox7.lo ∧
    valueBox3.hi * (3 : ℤ) ^ 1424 ≤ denominator ∧
    valueBox5.hi ≤ (42 : ℤ) ^ 400 * valueBox3.lo ∧
    valueBox7.hi ≤ (42 : ℤ) ^ 440 * valueBox5.lo :=
  ⟨trace3_checked, trace5_checked, trace7_checked,
   valueBox3_positive, valueBox5_positive, valueBox7_positive,
   seed_checked, transfer35_checked, transfer57_checked⟩

def lower (b : Box) : ℚ := (b.lo : ℚ) / (denominator : ℚ)
def upper (b : Box) : ℚ := (b.hi : ℚ) / (denominator : ℚ)

theorem lower_pos {b : Box} (hb : 0 < b.lo) : 0 < lower b := by
  have hd : (0 : ℚ) < (denominator : ℚ) := by exact_mod_cast denominator_pos
  have hl : (0 : ℚ) < (b.lo : ℚ) := by exact_mod_cast hb
  exact div_pos hl hd

theorem contains_to_rational {b : Box} {v : ℝ}
    (h : Contains denominator b v) :
    (lower b : ℝ) ≤ v ∧ v ≤ (upper b : ℝ) := by
  have hd : (0 : ℝ) < (denominator : ℝ) := by exact_mod_cast denominator_pos
  constructor
  · change (((b.lo : ℚ) / (denominator : ℚ) : ℚ) : ℝ) ≤ v
    push_cast
    exact (div_le_iff₀ hd).2 (by simpa [mul_comm] using h.1)
  · change v ≤ (((b.hi : ℚ) / (denominator : ℚ) : ℚ) : ℝ)
    push_cast
    exact (le_div_iff₀ hd).2 (by simpa [mul_comm] using h.2)

theorem contains_to_abs {b : Box} {v : ℝ}
    (hb : 0 < b.lo) (h : Contains denominator b v) :
    (lower b : ℝ) ≤ |v| ∧ |v| ≤ (upper b : ℝ) := by
  have hr := contains_to_rational h
  have hl : (0 : ℝ) < (lower b : ℝ) := by exact_mod_cast (lower_pos hb)
  rw [abs_of_pos (hl.trans_le hr.1)]
  exact hr

theorem seed_rational_check : upper valueBox3 * (3 : ℚ) ^ 1424 ≤ 1 := by
  have hd : (0 : ℚ) < (denominator : ℚ) := by exact_mod_cast denominator_pos
  have hc : (valueBox3.hi : ℚ) * (3 : ℚ) ^ 1424 ≤ (denominator : ℚ) := by
    exact_mod_cast seed_checked
  unfold upper
  rw [div_mul_eq_mul_div]
  apply (div_le_iff₀ hd).2
  simpa only [one_mul] using hc

theorem transfer_rational_check {a b : Box} {n : ℕ}
    (h : b.hi ≤ (42 : ℤ) ^ n * a.lo) :
    upper b ≤ (42 : ℚ) ^ n * lower a := by
  have hd : (0 : ℚ) < (denominator : ℚ) := by exact_mod_cast denominator_pos
  have hc : (b.hi : ℚ) ≤ (42 : ℚ) ^ n * (a.lo : ℚ) := by exact_mod_cast h
  unfold upper lower
  rw [← mul_div_assoc]
  exact div_le_div_of_nonneg_right hc hd.le

/- Explicit coefficient argument; the actual external error that affected the
previous candidate was not supplied. This is a replacement proof candidate,
not a claim to have diagnosed that earlier compiler failure. -/


def coeffAt : List ℤ → ℕ → ℤ
  | [], _ => 0
  | c :: _, 0 => c
  | _ :: cs, n + 1 => coeffAt cs n

theorem coeff_polyOfCoeffs (cs : List ℤ) (n : ℕ) :
    (polyOfCoeffs cs).coeff n = coeffAt cs n := by
  induction cs generalizing n with
  | nil =>
      change (0 : Polynomial ℤ).coeff n = 0
      simp only [Polynomial.coeff_zero]
  | cons c cs ih =>
      cases n with
      | zero =>
          change (Polynomial.C c + Polynomial.X * polyOfCoeffs cs).coeff 0 = c
          rw [Polynomial.coeff_add, Polynomial.coeff_X_mul_zero]
          simp only [Polynomial.coeff_C_zero, add_zero]
      | succ n =>
          change (Polynomial.C c + Polynomial.X * polyOfCoeffs cs).coeff (n + 1) =
            coeffAt cs n
          have hc : (Polynomial.C c : Polynomial ℤ).coeff (n + 1) = 0 :=
            Polynomial.coeff_C_succ
          rw [Polynomial.coeff_add, hc, Polynomial.coeff_X_mul, zero_add]
          exact ih n

theorem coeffAt_eq_zero_of_length_le (cs : List ℤ) (n : ℕ)
    (h : cs.length ≤ n) : coeffAt cs n = 0 := by
  induction cs generalizing n with
  | nil => rfl
  | cons c cs ih =>
      cases n with
      | zero =>
          change cs.length + 1 ≤ 0 at h
          omega
      | succ n =>
          change coeffAt cs n = 0
          change cs.length + 1 ≤ n + 1 at h
          exact ih n (by omega)

theorem natDegree_polyOfCoeffs (cs : List ℤ) (n : ℕ)
    (hlen : cs.length = n + 1) (hlast : coeffAt cs n ≠ 0) :
    (polyOfCoeffs cs).natDegree = n := by
  have hbound : (polyOfCoeffs cs).natDegree ≤ n := by
    apply Polynomial.natDegree_le_iff_coeff_eq_zero.mpr
    intro N hN
    rw [coeff_polyOfCoeffs]
    exact coeffAt_eq_zero_of_length_le cs N (by omega)
  have hcoeff : (polyOfCoeffs cs).coeff n ≠ 0 := by
    rw [coeff_polyOfCoeffs]
    exact hlast
  exact Polynomial.natDegree_eq_of_le_of_coeff_ne_zero hbound hcoeff



theorem polynomial3_degree : (polyOfCoeffs coeff3).natDegree = 37 :=
  natDegree_polyOfCoeffs coeff3 37 coeff3_length (by decide)

theorem polynomial5_degree : (polyOfCoeffs coeff5).natDegree = 37 :=
  natDegree_polyOfCoeffs coeff5 37 coeff5_length (by decide)

theorem polynomial7_degree : (polyOfCoeffs coeff7).natDegree = 37 :=
  natDegree_polyOfCoeffs coeff7 37 coeff7_length (by decide)

/-- The remaining bridges.  These assert source identity and actual-zeta
    containment, never the desired seed or transfer inequality. -/
structure CanonicalSemantics : Prop where
  polynomial3 : primitivePolynomial 1 0 = polyOfCoeffs coeff3
  polynomial5 : primitivePolynomial 2 0 = polyOfCoeffs coeff5
  polynomial7 : primitivePolynomial 3 0 = polyOfCoeffs coeff7
  zeta3 : Contains denominator zetaBox3 (actualZeta 1)
  zeta5 : Contains denominator zetaBox5 (actualZeta 2)
  zeta7 : Contains denominator zetaBox7 (actualZeta 3)

theorem canonical_enclosure (k : ℕ) (cs : List ℤ) (xb : Box) (tr : List Box)
    (hid : primitivePolynomial k 0 = polyOfCoeffs cs)
    (hz : Contains denominator xb (actualZeta k))
    (hc : checkTrace denominator xb cs tr = true) :
    Contains denominator (headBox tr) (value k 0) := by
  have h := checkTrace_sound denominator_pos hz cs tr hc
  simpa only [value, ZetaBetaHankel.USPD.evalIntPoly, hid,
    eval_map_polyOfCoeffs] using h

/-- Exact implication from the explicit source/analytic bridges. -/
theorem admission_of_semantics (s : CanonicalSemantics) : N0Admission := by
  have h3 : Contains denominator valueBox3 (value 1 0) := by
    simpa only [trace3_head] using
      canonical_enclosure 1 coeff3 zetaBox3 trace3 s.polynomial3 s.zeta3 trace3_checked
  have h5 : Contains denominator valueBox5 (value 2 0) := by
    simpa only [trace5_head] using
      canonical_enclosure 2 coeff5 zetaBox5 trace5 s.polynomial5 s.zeta5 trace5_checked
  have h7 : Contains denominator valueBox7 (value 3 0) := by
    simpa only [trace7_head] using
      canonical_enclosure 3 coeff7 zetaBox7 trace7 s.polynomial7 s.zeta7 trace7_checked
  apply admission_of_rational_enclosures
    (lower valueBox3) (upper valueBox3)
    (lower valueBox5) (upper valueBox5)
    (lower valueBox7) (upper valueBox7)
  · rw [s.polynomial3]; exact polynomial3_degree
  · rw [s.polynomial5]; exact polynomial5_degree
  · rw [s.polynomial7]; exact polynomial7_degree
  · exact contains_to_abs valueBox3_positive h3
  · exact contains_to_abs valueBox5_positive h5
  · exact contains_to_abs valueBox7_positive h7
  · exact lower_pos valueBox3_positive
  · exact lower_pos valueBox5_positive
  · exact lower_pos valueBox7_positive
  · exact seed_rational_check
  · exact transfer_rational_check transfer35_checked
  · exact transfer_rational_check transfer57_checked

theorem goodAt_zero_of_semantics (s : CanonicalSemantics) : GoodAt 0 :=
  good_zero_of_admission (admission_of_semantics s)

end ZetaBetaHankel.Zeta357DigitAdmission


