theorem geometryResidue_source (t : Fin 73) :
    ∀ a ∈ Finset.Icc 4 40,
      (rationalLiteral (geometryRem t)).eval (-((a : ℚ) ^ 2)) /
        (Polynomial.derivative (ZetaBetaHankel.Repaired.D_tail 3 40)).eval
          (-((a : ℚ) ^ 2)) = residueAt (geometryResidue t) a := by
  intro a ha
  have hb := Finset.mem_Icc.mp ha
  have hi : a - 4 < 37 := by omega
  have he : a - 4 + 4 = a := by omega
  rw [geometrySourceTail, rationalLiteral_eval, rationalLiteral_derivative_eval]
  simpa only [he] using residue_all_checked t ⟨a - 4, hi⟩

