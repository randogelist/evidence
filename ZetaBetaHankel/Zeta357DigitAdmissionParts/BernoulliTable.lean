theorem bernoulliPrimeRecurrence_checked :
    ∀ n : Fin 103,
      ratAt bernoulliPrimeTable n.val =
        1 - ∑ k : Fin n.val,
          ((n.val.choose k.val : ℕ) : ℚ) /
            ((n.val : ℚ) - (k.val : ℚ) + 1) *
              ratAt bernoulliPrimeTable k.val := by decide

theorem bernoulliPrime_table :
    ∀ n : ℕ, n < 103 → _root_.bernoulli' n = ratAt bernoulliPrimeTable n := by
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro hn
    rw [bernoulli'_def']
    calc
      1 - ∑ k : Fin n,
          ((n.choose k.val : ℕ) : ℚ) / ((n : ℚ) - (k.val : ℚ) + 1) *
            _root_.bernoulli' k.val =
          1 - ∑ k : Fin n,
            ((n.choose k.val : ℕ) : ℚ) / ((n : ℚ) - (k.val : ℚ) + 1) *
              ratAt bernoulliPrimeTable k.val := by
        congr 1
        apply Finset.sum_congr rfl
        intro k hk
        rw [ih k.val k.isLt (lt_trans k.isLt hn)]
      _ = ratAt bernoulliPrimeTable n :=
        (bernoulliPrimeRecurrence_checked ⟨n, hn⟩).symm

def bernoulliValue (n : ℕ) : ℚ :=
  (-1 : ℚ) ^ n * ratAt bernoulliPrimeTable n

theorem bernoulli_table (n : Fin 103) :
    _root_.bernoulli n.val = bernoulliValue n.val := by
  unfold bernoulli bernoulliValue
  rw [bernoulliPrime_table n.val n.isLt]

