/- Executable rational coefficient arithmetic with polynomial semantics. -/
namespace ZetaBetaHankel.Zeta357CanonicalArithmetic

open scoped BigOperators
open Polynomial

def qHorner : List ℚ → ℚ[X]
  | [] => 0
  | a :: as => C a + X * qHorner as

theorem qHorner_coeff (cs : List ℚ) (n : ℕ) :
    (qHorner cs).coeff n = ratAt cs n := by
  induction cs generalizing n with
  | nil => simp [qHorner, ratAt]
  | cons a cs ih =>
    cases n with
    | zero =>
      change (C a + X * qHorner cs).coeff 0 = a
      rw [Polynomial.coeff_add, Polynomial.coeff_X_mul_zero]
      simp only [Polynomial.coeff_C_zero, add_zero]
    | succ n =>
      change (C a + X * qHorner cs).coeff (n + 1) = ratAt cs n
      have hc : (C a : ℚ[X]).coeff (n + 1) = 0 := by simp
      rw [Polynomial.coeff_add, hc, Polynomial.coeff_X_mul, zero_add]
      exact ih n

theorem rationalLiteral_eq_qHorner (cs : List ℚ) : rationalLiteral cs = qHorner cs := by
  ext n
  rw [rationalLiteral_coeff, qHorner_coeff]

def qadd : List ℚ → List ℚ → List ℚ
  | [], ys => ys
  | xs, [] => xs
  | a :: xs, b :: ys => (a + b) :: qadd xs ys

def qscale (a : ℚ) : List ℚ → List ℚ
  | [] => []
  | b :: bs => (a * b) :: qscale a bs

def qmul : List ℚ → List ℚ → List ℚ
  | [], _ => []
  | a :: as, bs => qadd (qscale a bs) (0 :: qmul as bs)

def qpow (cs : List ℚ) : ℕ → List ℚ
  | 0 => [1]
  | n + 1 => qmul (qpow cs n) cs

def qshift : ℕ → List ℚ → List ℚ
  | 0, cs => cs
  | n + 1, cs => 0 :: qshift n cs

def qeval : List ℚ → ℚ → ℚ
  | [], _ => 0
  | a :: as, x => a + x * qeval as x

def qderiv : List ℚ → List ℚ
  | [] => []
  | _ :: as => qadd as (0 :: qderiv as)

theorem qHorner_add (as bs : List ℚ) :
    qHorner (qadd as bs) = qHorner as + qHorner bs := by
  induction as generalizing bs with
  | nil => simp [qadd, qHorner]
  | cons a as ih =>
    cases bs with
    | nil => simp [qadd, qHorner]
    | cons b bs =>
      simp only [qadd, qHorner, ih, Polynomial.C_add]
      ring

theorem qHorner_scale (a : ℚ) (bs : List ℚ) :
    qHorner (qscale a bs) = C a * qHorner bs := by
  induction bs with
  | nil => simp [qscale, qHorner]
  | cons b bs ih =>
    simp only [qscale, qHorner, ih, Polynomial.C_mul]
    ring

theorem qHorner_mul (as bs : List ℚ) :
    qHorner (qmul as bs) = qHorner as * qHorner bs := by
  induction as with
  | nil => simp [qmul, qHorner]
  | cons a as ih =>
    simp only [qmul, qHorner_add, qHorner_scale, qHorner, ih, map_zero, zero_add]
    ring

theorem qHorner_pow (cs : List ℚ) (n : ℕ) :
    qHorner (qpow cs n) = (qHorner cs) ^ n := by
  induction n with
  | zero => simp [qpow, qHorner]
  | succ n ih => rw [qpow, qHorner_mul, ih, pow_succ]

theorem qHorner_shift (n : ℕ) (cs : List ℚ) :
    qHorner (qshift n cs) = X ^ n * qHorner cs := by
  induction n with
  | zero => simp [qshift]
  | succ n ih =>
    simp only [qshift, qHorner, map_zero, zero_add, ih, pow_succ]
    ring

theorem qHorner_eval (cs : List ℚ) (x : ℚ) :
    (qHorner cs).eval x = qeval cs x := by
  induction cs with
  | nil => simp [qHorner, qeval]
  | cons a as ih => simp [qHorner, qeval, ih]

theorem qHorner_deriv (cs : List ℚ) :
    qHorner (qderiv cs) = (qHorner cs).derivative := by
  induction cs with
  | nil => simp [qderiv, qHorner]
  | cons a as ih =>
    simp [qderiv, qHorner_add, qHorner, ih, Polynomial.derivative_mul]

theorem rationalLiteral_eval (cs : List ℚ) (x : ℚ) :
    (rationalLiteral cs).eval x = qeval cs x := by
  rw [rationalLiteral_eq_qHorner]
  exact qHorner_eval cs x

theorem rationalLiteral_derivative_eval (cs : List ℚ) (x : ℚ) :
    (rationalLiteral cs).derivative.eval x = qeval (qderiv cs) x := by
  rw [rationalLiteral_eq_qHorner, ← qHorner_deriv]
  exact qHorner_eval (qderiv cs) x

theorem rationalLiteral_qadd (as bs : List ℚ) :
    rationalLiteral (qadd as bs) = rationalLiteral as + rationalLiteral bs := by
  simp only [rationalLiteral_eq_qHorner, qHorner_add]

theorem rationalLiteral_qmul (as bs : List ℚ) :
    rationalLiteral (qmul as bs) = rationalLiteral as * rationalLiteral bs := by
  simp only [rationalLiteral_eq_qHorner, qHorner_mul]

def QEq (as bs : List ℚ) : Prop :=
  ∀ j : Fin (max as.length bs.length), ratAt as j.val = ratAt bs j.val

instance (as bs : List ℚ) : Decidable (QEq as bs) := by
  unfold QEq
  infer_instance

theorem rationalLiteral_eq_of_QEq {as bs : List ℚ} (h : QEq as bs) :
    rationalLiteral as = rationalLiteral bs := by
  ext j
  rw [rationalLiteral_coeff, rationalLiteral_coeff]
  by_cases hj : j < max as.length bs.length
  · exact h ⟨j, hj⟩
  · have ha : as.length ≤ j := by omega
    have hb : bs.length ≤ j := by omega
    rw [ratAt_out as j ha, ratAt_out bs j hb]

theorem qHorner_eq_of_QEq {as bs : List ℚ} (h : QEq as bs) :
    qHorner as = qHorner bs := by
  simpa only [rationalLiteral_eq_qHorner] using rationalLiteral_eq_of_QEq h

theorem rationalLiteral_natDegree (cs : List ℚ) (n : ℕ)
    (hl : cs.length = n + 1) (hc : ratAt cs n ≠ 0) :
    (rationalLiteral cs).natDegree = n := by
  apply Polynomial.natDegree_eq_of_le_of_coeff_ne_zero
  · apply Polynomial.natDegree_le_iff_coeff_eq_zero.mpr
    intro j hj
    rw [rationalLiteral_coeff]
    exact ratAt_out cs j (by omega)
  · rw [rationalLiteral_coeff]
    exact hc

theorem rationalLiteral_degree_lt_of_length_le (cs : List ℚ) (n : ℕ)
    (hl : cs.length ≤ n) : (rationalLiteral cs).degree < (n : WithBot ℕ) := by
  apply (Polynomial.degree_lt_iff_coeff_zero _ n).mpr
  intro j hj
  rw [rationalLiteral_coeff]
  exact ratAt_out cs j (le_trans hl hj)

def squareFactors : List ℕ → List ℚ
  | [] => [1]
  | a :: as => qmul [((a : ℚ) ^ 2), 1] (squareFactors as)

theorem qHorner_squareFactors (as : List ℕ) :
    qHorner (squareFactors as) =
      (as.map (fun a => (X + C ((a : ℚ) ^ 2) : ℚ[X]))).prod := by
  induction as with
  | nil => simp [squareFactors, qHorner]
  | cons a as ih =>
    simp [squareFactors, qHorner_mul, qHorner, ih, add_comm]

end ZetaBetaHankel.Zeta357CanonicalArithmetic

