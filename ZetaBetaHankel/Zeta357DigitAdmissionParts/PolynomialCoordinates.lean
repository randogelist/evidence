theorem geometrySourceNumerator (t : Fin 73) :
    (ZetaBetaHankel.Repaired.D_poly 3) ^ 5 * X ^ t.val =
      rationalLiteral (geometryNum t) := by
  rw [geometrySourceDN, rationalLiteral_eq_qHorner, ← qHorner_pow]
  rw [qHorner_eq_of_QEq geometryBase_checked]
  rw [rationalLiteral_eq_qHorner]
  change qHorner baseCoeffs * X ^ t.val = qHorner (qshift t.val baseCoeffs)
  rw [qHorner_shift, mul_comm]

theorem geometryDivision (t : Fin 73) :
    rationalLiteral (geometryRem t) + ZetaBetaHankel.Repaired.D_tail 3 40 *
      rationalLiteral (geometryQuot t) =
        (ZetaBetaHankel.Repaired.D_poly 3) ^ 5 * X ^ t.val := by
  rw [geometrySourceTail, ← rationalLiteral_qmul, ← rationalLiteral_qadd]
  rw [rationalLiteral_eq_of_QEq (geometryDivision_checked t)]
  exact (geometrySourceNumerator t).symm

theorem geometryTailDegree :
    (ZetaBetaHankel.Repaired.D_tail 3 40).degree = (37 : WithBot ℕ) := by
  rw [geometrySourceTail]
  apply (Polynomial.degree_eq_iff_natDegree_eq_of_pos (by decide : 0 < 37)).mpr
  exact rationalLiteral_natDegree tailCoeffs 37 (by decide) (by decide)

theorem geometryRemDegree (t : Fin 73) :
    (rationalLiteral (geometryRem t)).degree <
      (ZetaBetaHankel.Repaired.D_tail 3 40).degree := by
  rw [geometryTailDegree]
  exact rationalLiteral_degree_lt_of_length_le (geometryRem t) 37 (geometryRemLength t)

